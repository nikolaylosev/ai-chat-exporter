{
  "name": "ai-chat-exporter",
  "version": "0.5.3",
  "private": true,
  "description": "Chrome extension that exports Claude and Gemini chats to Markdown with all attachments",
  "license": "MIT",
  "author": "Nikolay Losev",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "icons": "node scripts/make-icons.mjs",
    "locales": "python3 scripts/locales.py"
  },
  "dependencies": {
    "fflate": "~0.8.3",
    "marked": "18.1.0",
    "preact": "^10.29.8",
    "zod": "~4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
